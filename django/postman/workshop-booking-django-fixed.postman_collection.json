{
  "info": {
    "name": "Workshop Booking System Django — fixed trailing slashes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Исправленная коллекция для Django + DRF. Все URL оканчиваются на '/', а тестовые пользователи получают уникальные email и username."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "workshopId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "futureStartsAt",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminUsername",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "userUsername",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health/"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString();",
              "pm.collectionVariables.set('adminEmail', `admin_${suffix}@example.com`);",
              "pm.collectionVariables.set('adminUsername', `admin_${suffix}`);",
              "pm.collectionVariables.set('userEmail', `user_${suffix}@example.com`);",
              "pm.collectionVariables.set('userUsername', `user_${suffix}`);",
              "pm.collectionVariables.unset('adminToken');",
              "pm.collectionVariables.unset('userToken');",
              "pm.collectionVariables.unset('workshopId');",
              "pm.collectionVariables.unset('bookingId');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Service is alive', function () {",
              "    pm.expect(json.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('Admin created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('adminToken', json.token);",
              "pm.test('First user is admin', function () {",
              "    pm.expect(json.user.role).to.eql('ADMIN');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('Admin login OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('adminToken', json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Create workshop as admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Token {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/workshops/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Django REST Framework Workshop\",\n  \"description\": \"Master class about building REST API with Django and DRF.\",\n  \"starts_at\": \"{{futureStartsAt}}\",\n  \"duration_minutes\": 120,\n  \"capacity\": 2,\n  \"location\": \"Online\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "const future = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString();",
              "pm.collectionVariables.set('futureStartsAt', future);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('Workshop created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('workshopId', json.id);",
              "pm.test('Workshop has free seats', function () {",
              "    pm.expect(json.available_seats).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Public workshops list",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/workshops/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('List is public', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Public workshop detail",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/workshops/{{workshopId}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('Detail is public', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Register user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"username\": \"{{userUsername}}\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('User created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('userToken', json.token);",
              "pm.test('Second user is regular user', function () {",
              "    pm.expect(json.user.role).to.eql('USER');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Login user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('User login OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('userToken', json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 User cannot create workshop",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Token {{userToken}}"
          }
        ],
        "url": "{{baseUrl}}/workshops/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Forbidden Workshop\",\n  \"description\": \"This request must be rejected for USER role.\",\n  \"starts_at\": \"{{futureStartsAt}}\",\n  \"duration_minutes\": 60,\n  \"capacity\": 5,\n  \"location\": \"Online\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('Regular user is forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Create booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Token {{userToken}}"
          }
        ],
        "url": "{{baseUrl}}/bookings/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"workshop_id\": \"{{workshopId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('Booking created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('bookingId', json.id);",
              "pm.test('Booking contains workshop data', function () {",
              "    pm.expect(json.workshop).to.be.an('object');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11 My bookings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{userToken}}"
          }
        ],
        "url": "{{baseUrl}}/bookings/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('Own bookings returned', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Response is array', function () {",
              "    pm.expect(json).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Duplicate booking is rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Token {{userToken}}"
          }
        ],
        "url": "{{baseUrl}}/bookings/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"workshop_id\": \"{{workshopId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('Duplicate booking rejected', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Cancel booking",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{userToken}}"
          }
        ],
        "url": "{{baseUrl}}/bookings/{{bookingId}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('Booking cancelled', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}